# Standardwerte fuer die Entwicklung. Echte Secrets gehoeren in .env.local
# (lokal) bzw. in die .env neben docker-compose.yml (Server) – nie ins Git.
APP_ENV=dev
APP_SECRET=dev-secret-nicht-fuer-produktion

# MariaDB aus docker-compose.yml (nur auf 127.0.0.1 erreichbar)
DATABASE_URL="mysql://werkstatt:werkstatt@127.0.0.1:3307/werkstatt?serverVersion=11.4.0-MariaDB&charset=utf8mb4"

# Schluessel erzeugen: php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dev-passphrase-nicht-fuer-produktion
# Gueltigkeit des Logins in Sekunden (12 h = eine Schicht)
JWT_TTL=43200
