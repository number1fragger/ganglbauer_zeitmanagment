# Vorlage fuer die .env neben docker-compose.yml (Server).
# Am einfachsten: ./deploy/init-env.sh <domain> – das erzeugt die Datei mit
# zufaelligen Passwoertern. Ohne .env laufen die Entwicklungswerte.
COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml

# Domain der App (DNS-Eintrag muss auf den Server zeigen) – oder ":80" fuer reines HTTP
DOMAIN=zeit.example.at

# Jeweils z. B. mit: openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
APP_SECRET=
JWT_PASSPHRASE=

# Login-Gueltigkeit in Sekunden (12 h = eine Schicht)
JWT_TTL=43200

# Port 8080 nur am Server selbst – von aussen geht alles ueber Caddy (80/443)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
