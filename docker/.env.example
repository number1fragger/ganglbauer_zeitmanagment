# Vorlage fuer den Docker-Stack. Einmalig kopieren und anpassen:
#   cp .env.example .env
# Die echte .env gehoert NICHT ins Git (steht in .gitignore).

# Port, unter dem die App erreichbar ist: http://localhost:8080
HTTP_PORT=8080

# Zeitzone der Werkstatt – Arbeitszeiten "ab 07:00" gelten hier.
APP_TIMEZONE=Europe/Vienna

# Datenbank (nur intern zwischen den Containern erreichbar)
DB_NAME=zeitmanagement
DB_USER=zeitmanagement
DB_PASSWORD=bitte-aendern-db
DB_ROOT_PASSWORD=bitte-aendern-root

# Geheimnisse fuer Symfony und den Login (JWT). Zufaellige Werte erzeugen z. B. mit:
#   openssl rand -hex 32
APP_SECRET=bitte-aendern-app-secret
JWT_PASSPHRASE=bitte-aendern-jwt

# Erster Chef-Zugang. Wird beim Start angelegt, falls es ihn noch nicht gibt.
# Nach dem ersten Anmelden das Passwort unter "Einstellungen" aendern.
ADMIN_EMAIL=chef@ganglbauer.at
ADMIN_PASSWORD=bitte-aendern-chef
ADMIN_FIRSTNAME=Franz
ADMIN_LASTNAME=Ganglbauer
