# Vorlage: einmal nach .env kopieren (cp env.dist .env).
# Echte Secrets gehoeren in .env.local und nicht ins Git.
APP_ENV=dev
APP_SECRET=change_me_in_env_local
# Zeitzone der Werkstatt – Arbeitszeiten "ab 07:00" gelten hier.
APP_TIMEZONE=Europe/Vienna

# --- Datenbank ---------------------------------------------------------------
# MariaDB aus docker-compose.yml, erreichbar ueber den Port 3307 am Host (3306 ist oft von einem lokalen MySQL belegt).
DATABASE_URL="mysql://zeitmanagement:zeitmanagement@127.0.0.1:3307/zeitmanagement?serverVersion=11.4.0-MariaDB&charset=utf8mb4"

# Alternative ganz ohne Docker: SQLite
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# --- JWT ---------------------------------------------------------------------
# Schluessel erzeugen: php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_in_env_local
JWT_TTL=3600

# --- CORS --------------------------------------------------------------------
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
